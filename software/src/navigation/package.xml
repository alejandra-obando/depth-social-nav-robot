<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation</name>
  <version>0.1.0</version>
  <description>State machine, follow and go-to-goal controllers, VFH obstacle avoidance and differential-drive kinematics. Plain Python, no ROS imports.</description>
  <maintainer email="team@example.com">depth-social-nav-robot team</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>corners</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
