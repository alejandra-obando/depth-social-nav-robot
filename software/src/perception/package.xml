<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception</name>
  <version>0.1.0</version>
  <description>Detection of the person's AprilTags, person tracking (Kalman) and obstacle points from the LiDAR and the depth camera. Plain Python, no ROS imports.</description>
  <maintainer email="team@example.com">depth-social-nav-robot team</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <!-- Also needs pupil-apriltags (pip): it has no rosdep key. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
